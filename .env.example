# Copy to .env for local use. On Vercel these are set in Project → Settings → Environment Variables.

# Postgres connection string (Vercel → Storage → Neon adds this automatically).
# Leave empty locally to use the built-in embedded database in ./data/pglite.
DATABASE_URL=

# Password for the back office at /admin
ADMIN_PASSWORD=change-me

# Optional: cookie signing secret. If unset, one is generated and kept in the database.
SESSION_SECRET=

# Optional: timezone for bill dates and "today" totals (default Asia/Kolkata)
APP_TIMEZONE=Asia/Kolkata

# Port (local only)
PORT=4173
